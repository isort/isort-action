#!/usr/bin/env bash

isort_version="${ISORT_VERSION:-}"
requirements_files="${REQUIREMENTS_FILES:-}"

extras="isort[requirements_deprecated_finder,pipfile_deprecated_finder]"

case "$isort_version" in
    "" | latest)
        requirement="$extras"
        ;;
    [=!~\<\>]*)
        requirement="${extras}${isort_version}"
        ;;
    *)
        requirement="${extras}==${isort_version}"
        ;;
esac

echo "::group::Install isort"

# shellcheck source=/dev/null
source "${HOME}/isort-venv/bin/activate"

echo "Installing $requirement"
python3 -m pip install "$requirement"
echo "::endgroup::"

if [ -n "$requirements_files" ]; then
    echo "::group::Install modules from requirements arg"
    for file in $requirements_files; do
        python3 -m pip install -r "$file"
    done
    echo "::endgroup::"
fi
